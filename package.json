{
  "name": "signal-session",
  "version": "0.1.0",
  "private": true,
  "description": "Local consent-first SmartSpectra breathing demo",
  "main": "src/main/electron-main.cjs",
  "scripts": {
    "build": "esbuild src/renderer/app.js --bundle --platform=browser --format=iife --outfile=src/renderer/dist/app.bundle.js --log-level=warning",
    "start": "npm run build && electron .",
    "test": "python -m unittest discover -s backend -p \"test_*.py\" -v"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.4.0",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "electron": "43.8.1",
    "esbuild": "^0.25.0"
  }
}
